# 智扫通 · 扫地机器人智能客服 Agent —— 环境变量模板
#
# 用法：复制本文件为 .env，填入真实值
#   cp .env.example .env
#
# 注意：当前代码未内置 .env 自动加载，仅创建 .env 文件不会生效。
#       让变量生效的方式二选一：
#       a) 直接在 shell 中导出环境变量（推荐，见 README「配置 API Key」）
#       b) 在 app.py 顶部手动加载：
#            from dotenv import load_dotenv
#            load_dotenv()
#          （python-dotenv 已随 langchain 依赖一并安装，无需额外安装）

# ============================================================
# 必填
# ============================================================
# 阿里云百炼（DashScope）API Key
# 申请地址：https://bailian.console.aliyun.com/
# 使用位置：model/factory.py 中的 ChatTongyi 与 DashScopeEmbeddings
DASHSCOPE_API_KEY=

# ============================================================
# 可选 —— 以下变量不填时均使用 DashScope 官方默认端点
# 仅在使用私有部署、代理或需要更换区域时需要修改
# ============================================================

# API 区域（默认 cn-beijing）
#DASHSCOPE_API_REGION=cn-beijing

# 接口版本（默认 v1）
#DASHSCOPE_API_VERSION=v1

# 自定义服务端点
# 默认：https://dashscope.aliyuncs.com/api/v1
#DASHSCOPE_HTTP_BASE_URL=

# OpenAI 兼容模式端点
# 默认：https://dashscope.aliyuncs.com/compatible-mode/v1
#DASHSCOPE_COMPATIBLE_BASE_URL=

# 密钥文件路径（改用文件方式提供 Key 时才需要）
#DASHSCOPE_API_KEY_FILE_PATH=
